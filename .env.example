# EmailJS — credenciales del formulario de contacto.
# La PUBLIC KEY de EmailJS está diseñada para vivir en el cliente; aun así
# se mantienen en variables de entorno por higiene de configuración.
# Crea un archivo .env (ignorado por git) con estos valores reales.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Correo destino que recibe los mensajes del formulario.
VITE_CONTACT_EMAIL=tu-correo@example.com
